# Shopify API Configuration Example
SHOPIFY_SHOP=your-shop-name.myshopify.com
SHOPIFY_CLIENT_ID=your_shopify_client_id
SHOPIFY_CLIENT_SECRET=your_shopify_client_secret
SHOPIFY_SCOPES=read_all_orders,read_orders,write_orders,read_products,read_customers,read_fulfillments,write_fulfillments,read_merchant_managed_fulfillment_orders,write_merchant_managed_fulfillment_orders,read_assigned_fulfillment_orders,write_assigned_fulfillment_orders,read_locations
SHOPIFY_ACCESS_TOKEN=your_shopify_access_token
